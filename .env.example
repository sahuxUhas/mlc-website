APP_NAME="দৈনিক মহালছড়ি নিউজ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://mahalcharinews.com
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcnews_db
DB_USERNAME=mcnews_user
DB_PASSWORD=change-me-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=mcnews_cache

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="news@mahalcharinews.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== নিরাপত্তা / রেট লিমিট =====
MC_COMMENT_THROTTLE_PER_MINUTE=3
MC_LOGIN_MAX_ATTEMPTS=5
MC_LOGIN_DECAY_MINUTES=10
MC_UPLOAD_MAX_KB=4096

# ===== cPanel shared hosting (public/ আলাদা করা হলে) =====
# কিছু হোস্টে document_root পরিবর্তন করা যায় না। সেক্ষেত্রে public/ এর ভেতরের
# ফাইল public_html/ এ রেখে নিচের ভেরিয়েবল দুটি সেট করুন (deploy/cpanel guide দেখুন)।
MC_ASSET_BASE=
